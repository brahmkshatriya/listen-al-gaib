{
  "manifest_version": 3,
  "name": "Listen al Gaib GPU Server",
  "version": "0.2.0",
  "description": "Starts a local GPU speech server for Listen al Gaib and stops it when its tab closes.",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://brahmkshatriya.github.io/reader/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open Listen al Gaib"
  },
  "key": ""
}
